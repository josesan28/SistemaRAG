GROQ_API_KEY=tu_api_key_aqui
# Modelo con soporte para function calling en Groq (opcional)
GROQ_MODEL=openai/gpt-oss-20b

# Fuente de FAQs para HDT5: file o database
FAQ_BACKEND=file

# Distancia coseno máxima aceptada como evidencia (opcional)
FAQ_MAX_COSINE_DISTANCE=0.65

# Evita mensajes de Hugging Face dentro del loop conversacional
HF_HUB_DISABLE_PROGRESS_BARS=1
HF_HUB_DISABLE_SYMLINKS_WARNING=1
HF_HUB_VERBOSITY=error
TRANSFORMERS_VERBOSITY=error

# Mostrar qué FAQs recuperó la herramienta
SHOW_TOOL_TRACE=false

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=parachute_faqs
POSTGRES_USER=parachute
POSTGRES_PASSWORD=parachute
